#!/bin/sh
set -e
# Ensure the script runs from the repository root
cd "$(git rev-parse --show-toplevel)"

# Staged files (added/copied/modified/renamed) matching the given pathspecs.
# staged_z: NUL-separated, safe for xargs -0. has_staged: true if any match.
staged_z() {
  git diff --cached --name-only -z --diff-filter=ACMR -- "$@"
}
has_staged() {
  [ -n "$(git diff --cached --name-only --diff-filter=ACMR -- "$@")" ]
}

# Pathspecs
C_ALL="src/*.c src/*.h"
C_SRC="src/*.c"
CMAKE_SPECS="CMakeLists.txt cmake/*.cmake"
MD_SPECS=":(glob)**/*.md :(exclude,glob)**/CHANGELOG.md :(exclude,glob)**/plan.md :(exclude,glob)**/next_thing.md"

# Anything staged at all? If not, there is nothing to do.
if [ -z "$(git diff --cached --name-only --diff-filter=ACMR)" ]; then
  exit 0
fi

echo "Checking for typos..."
git diff --cached --name-only -z --diff-filter=ACMR | xargs -0 typos --force-exclude

# --- C sources -------------------------------------------------------------
# shellcheck disable=SC2086
if has_staged $C_ALL; then
  echo "Formatting C code..."
  # shellcheck disable=SC2086
  staged_z $C_ALL | xargs -0 clang-format -i
  # shellcheck disable=SC2086
  staged_z $C_ALL | xargs -0 git add
fi

# shellcheck disable=SC2086
if has_staged $C_SRC; then
  echo "Running clang-tidy..."
  if [ ! -f build/compile_commands.json ]; then
    echo "error: build/compile_commands.json missing."
    echo "Run: cmake -S . -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
    exit 1
  fi
  # shellcheck disable=SC2086
  staged_z $C_SRC | xargs -0 clang-tidy -p build --quiet
fi

# --- CMake files -----------------------------------------------------------
# shellcheck disable=SC2086
if has_staged $CMAKE_SPECS; then
  echo "Formatting CMake files..."
  # shellcheck disable=SC2086
  staged_z $CMAKE_SPECS | xargs -0 cmake-format -i
  # shellcheck disable=SC2086
  staged_z $CMAKE_SPECS | xargs -0 git add
fi

# --- Markdown --------------------------------------------------------------
# Word splitting on MD_SPECS is safe: none of the pathspecs contain spaces.
# shellcheck disable=SC2086
if has_staged $MD_SPECS; then
  echo "Fixing markdown files..."
  # shellcheck disable=SC2086
  staged_z $MD_SPECS | xargs -0 rumdl check --fix
  # shellcheck disable=SC2086
  staged_z $MD_SPECS | xargs -0 git add
fi

# --- Memory Safety Checks (Optional) -----
# Offered only when C or build files are staged, and after the formatters
# above so the sanitizers see the final code. Choosing "No" (or ESC) commits straight away
# A failing check aborts the commit
C_CHECK_SPECS="src/*.c src/*.h ctl/*.c CMakeLists.txt cmake/*.cmake"

ask_run_checks() {
  RUN_CHECKS=no
  case "${MIRU_PRECOMMIT_CHECKS:-ask}" in
  yes | 1)
    RUN_CHECKS=yes
    return 0
    ;;
  no | 0)
    return 0
    ;;
  esac

  if ! command -v fzf >/dev/null 2>&1; then
    echo "note: fzf not found, skipping memory-safe check prompt"
    return 0
  fi

  if ! (: </dev/tty) 2>/dev/null; then
    echo "note: No terminal available, skipping memory-safe check prompt"
    return 0
  fi

  answer=$(printf 'Yes\nNo\n' | fzf --height=8 --reverse --no-multi --cycle \
    --prompt='Run memory-safety checks (ASan/UBSan + GCC Analyzer)? ' \
    --header='Enter: select, Esc: Skip') || answer=No

  if [ "$answer" = "Yes" ]; then
    RUN_CHECKS=yes
  fi
}

# shellcheck disable=SC2086
if has_staged $C_CHECK_SPECS; then
  ask_run_checks
  if [ "$RUN_CHECKS" = "yes" ]; then
    echo "Running memory-safety checks (ASan/UBSan + GCC Analyzer)..."
    if ! bash scripts/sanitize.sh check; then
      echo
      echo "error: memory-safety checks failed, commit aborted"
      echo "Fix the issues above and commit again (or run: grim cast sanitize)"
      exit 1
    fi
  fi
fi

bash scripts/gen-contributors.sh >CONTRIBUTORS && echo "Contributors file updated"

exit 0
